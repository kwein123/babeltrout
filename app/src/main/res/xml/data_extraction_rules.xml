<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep settings and transcripts out of cloud backup and device-to-device transfer.
     Babeltrout holds nothing worth restoring, and spoken phrases can be sensitive. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
